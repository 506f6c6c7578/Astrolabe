---
import { pages, site } from "@/data/site";
import { createLogoMark } from "@/lib/brand";
---

<a href={pages.home} aria-label={`${site.name}, retour à l'accueil`}
   class="group inline-flex items-center gap-2.5 font-heading text-xl font-bold text-foreground">
    <svg class="size-8 shrink-0 text-primary transition-transform duration-500 ease-out group-hover:rotate-[24deg]"
         viewBox="0 0 64 64" aria-hidden="true" focusable="false">
        <rect width="64" height="64" rx="14" fill="currentColor"></rect>
        <g class="text-background" set:html={createLogoMark("currentColor")}/>
    </svg>
    <span>{site.name}</span>
</a>
