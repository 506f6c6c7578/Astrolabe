---
import Logo from "@/components/layout/Logo.astro";
import { credits, legalLinks, navigation, site } from "@/data/site";

const year = new Date().getFullYear();
const linkClass = "transition-colors hover:text-foreground hover:underline hover:underline-offset-4";
---

<footer class="mt-20 border-t bg-card">
    <div class="container-page grid gap-8 py-10 lg:grid-cols-[2fr_1fr_2fr] lg:items-start">
        <div class="grid max-w-sm gap-3">
            <Logo/>
            <p>{site.tagline}</p>
        </div>
        <nav aria-label="Navigation secondaire">
            <ul class="grid gap-2">
                {navigation.map(({ label, href }) => <li><a class={linkClass} href={href}>{label}</a></li>)}
            </ul>
        </nav>
        <ul class="grid gap-2 text-sm text-muted-foreground">
            {credits.map(({ label, href }) => (
                    <li><a class={linkClass} href={href} target="_blank" rel="noopener noreferrer">{label}</a></li>
            ))}
        </ul>
    </div>
    <div class="border-t py-6 text-sm text-muted-foreground">
        <div class="container-page flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
            <p>© {year} <a class={linkClass} href={site.author.url}>{site.author.name}</a>. Tous droits réservés.</p>
            <nav aria-label="Informations légales">
                <ul class="flex flex-wrap gap-x-5 gap-y-2">
                    {Object.values(legalLinks).map(({ label, href }) => <li><a class={linkClass} href={href}>{label}</a></li>)}
                </ul>
            </nav>
        </div>
    </div>
</footer>
